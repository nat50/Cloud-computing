# Copy to .env and fill in PROJECT_ID. infra/, src/producer.py and tools/ all read this file.
#   cp .env.example .env

PROJECT_ID=your-project-id
REGION=us-central1

# Resource names (defaults are fine)
BUCKET=${PROJECT_ID}-yolo-frames
TOPIC=frames
DLQ_TOPIC=frames-dlq
SUBSCRIPTION=frames-workers
AUDIT_SUBSCRIPTION=frames-audit
DLQ_AUDIT_SUBSCRIPTION=dlq-audit
DATASET=yolo_pipeline
AR_REPO=yolo
CLUSTER=yolo-cluster
NAMESPACE=yolo

# Worker image tag (bump when you rebuild)
IMAGE_TAG=v1

# KEDA scaling
KEDA_TARGET_BACKLOG=10
KEDA_MIN_REPLICAS=1
KEDA_MAX_REPLICAS=8
